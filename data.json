  "bottlenecks": {
    "as_of": "2025",
    "sources": [
      "DAKSH State of Tribunals 2025",
      "Standing Committee on Finance 32nd Report (2021) & 67th ATR (2023)",
      "Supreme Court suo motu order, 29 Apr 2026",
      "Economic Survey 2025–26"
    ],
    "items": [
      {
        "id": "vacancies",
        "title": "Chronic vacancies",
        "summary": "9 of 63 sanctioned member positions vacant. The SC has had to repeatedly compel appointments since 2021.",
        "key_source": "SC suo motu order, 29 Apr 2026"
      },
      {
        "id": "contractual_staff",
        "title": "Contractual staffing",
        "summary": "88% of NCLT's workforce is on contract — 'unheard of' for a quasi-judicial institution, per the Supreme Court. Undermines institutional memory and case-tracking.",
        "key_source": "DAKSH 2025 / SC 29 Apr 2026"
      },
      {
        "id": "scheduling",
        "title": "Scheduling chaos",
        "summary": "Members preside over multiple courts in a day. DAKSH found Chennai Bench Court-I listed 'after completion of' another bench in 83% of cause lists studied.",
        "key_source": "DAKSH NCLT analysis, 2024"
      },
      {
        "id": "infrastructure",
        "title": "Physical infrastructure",
        "summary": "Power outages, inadequate courtrooms, lack of permanent premises — raised in writing to MCA by an RS MP in May 2026.",
        "key_source": "Letter to MoS MCA, 18 May 2026"
      },
      {
        "id": "domain_expertise",
        "title": "Domain expertise gap",
        "summary": "Members appointed often lack economic and business expertise. Technical members are drawn from ICLS but commercial sectoral knowledge varies widely.",
        "key_source": "DAKSH 2025"
      },
      {
        "id": "it_systems",
        "title": "IT and digitisation",
        "summary": "Integrated case-management IT platform repeatedly recommended (Standing Committee 2021, 2024) but only partially implemented. E-filing exists; hybrid courts uneven across benches.",
        "key_source": "Standing Committee 32nd & 67th Reports"
      },
      {
        "id": "rp_capacity",
        "title": "Resolution Professional capacity",
        "summary": "Of 4,527 registered Resolution Professionals, only 2,198 (49%) hold active Authorisation for Assignment. CIRP throughput depends on RP availability as much as on NCLT capacity.",
        "key_source": "Economic Survey 2025–26"
      },
      {
        "id": "parallel_litigation",
        "title": "Parallel litigation & adjournments",
        "summary": "Overlapping proceedings before NCLT, NCLAT, High Courts, and Supreme Court routinely stay or delay CIRP. Frequent adjournments compound the problem.",
        "key_source": "Standing Committee 32nd Report; SC 29 Apr 2026"
      }
    ]
  }
}
